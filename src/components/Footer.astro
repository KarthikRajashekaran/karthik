---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="footer-inner">
		<p>
			<span class="gradient-text footer-name">{site.name.split(' ')[0]}</span>
			<span class="muted"> · © {year}</span>
		</p>
		<p class="muted footer-tech">
			<a href="https://astro.build">Astro</a> · GitHub Pages
		</p>
	</div>
</footer>

<style>
	.footer {
		margin-top: 4rem;
		padding: 2rem 1.5rem 3rem;
		border-top: 1px solid var(--border);
		background: rgba(8, 12, 20, 0.5);
	}

	.footer-inner {
		max-width: var(--max);
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
	}

	.footer p {
		margin: 0;
		font-size: 0.875rem;
	}

	.footer-name {
		font-weight: 700;
	}

	.footer-tech a {
		color: var(--muted);
	}

	.footer-tech a:hover {
		color: var(--accent);
	}
</style>
