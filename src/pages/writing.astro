---
import Layout from '../layouts/Layout.astro';
import { posts, mediumProfile } from '../data/posts';
---

<Layout title="Writing" description="Articles on Medium">
	<h1>Writing</h1>
	<p class="lead">
		Articles on <a href={mediumProfile}>Medium @karthikrajashekaran</a>.
	</p>

	<ul class="post-list">
		{posts.map((post) => (
			<li>
				<a href={post.url} rel="noopener noreferrer">{post.title}</a>
				<div class="post-meta">{post.date}</div>
				{post.blurb && <p>{post.blurb}</p>}
			</li>
		))}
	</ul>
</Layout>
