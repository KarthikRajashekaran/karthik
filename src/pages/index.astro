---
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../data/site';
import { skillGroups } from '../data/skills';
import { path } from '../lib/paths';
---

<Layout>
	<section class="hero">
		<h1 class="hero-title">
			<span class="gradient-text">{site.name.split(' ')[0]}</span>
			{' '}{site.name.split(' ').slice(1).join(' ')}
		</h1>
		<p class="hero-sub">
			<strong>{site.title}</strong> — building analytics platforms with {site.tagline}.
		</p>

		<SocialLinks />

		<div class="cta-grid">
			<a class="cta-card" href={path('resume/')}>
				<h3>Resume</h3>
				<p>Experience, certifications, and background.</p>
				<span class="arrow" aria-hidden="true">→</span>
			</a>
			<a class="cta-card" href={path('writing/')}>
				<h3>Writing</h3>
				<p>Articles on dbt, Snowflake, Cortex, and semantic layers.</p>
				<span class="arrow" aria-hidden="true">→</span>
			</a>
			<a class="cta-card" href={site.links.github} rel="noopener noreferrer">
				<h3>GitHub</h3>
				<p>Open-source tools and data engineering projects.</p>
				<span class="arrow" aria-hidden="true">→</span>
			</a>
		</div>
	</section>

	<section>
		<span class="section-label">About</span>
		<h2>What I do</h2>
		<div class="about-block">
			{site.about.map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</section>

	<section>
		<span class="section-label">Stack</span>
		<h2>Skills & tools</h2>
		<div class="skills-grid">
			{
				skillGroups.map((group) => (
					<div class="skill-card">
						<h3>{group.label}</h3>
						<ul class="chips">
							{group.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>
</Layout>
